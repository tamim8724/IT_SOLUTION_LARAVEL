APP_NAME="e-Trust"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://e-trust.online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database: MongoDB (free cluster at https://www.mongodb.com/atlas)
# Atlas > Connect > Drivers > copy the connection string, put your DB user + password in it.
# Atlas > Network Access: allow 0.0.0.0/0 (Render has no fixed IP on the free plan).
DB_CONNECTION=mongodb
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@your-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE=etrust
# Quick local test without MongoDB: DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Contact form email. Choose ONE:
#  A) Render FREE plan -> use Resend (sends over HTTPS, not blocked):
#       MAIL_MAILER=resend  and  RESEND_KEY=re_xxxxxxxx
#  B) Render PAID plan or other hosting -> normal SMTP:
#       MAIL_MAILER=smtp + MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD
MAIL_MAILER=log
RESEND_KEY=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@e-trust.online"
# Contact form messages go here
CONTACT_TO_ADDRESS=info@e-trust.online

MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI assistant (/assistant). Add any of these keys and that AI switches on.
# Free ones are tried first; if one runs out of free quota the next one answers.
# Check them all with: php artisan ai:test
GEMINI_API_KEY="API key here" # free: https://aistudio.google.com/apikey
GROQ_API_KEY="API key here" # free: https://console.groq.com/keys
MISTRAL_API_KEY="API key here" # free plan: https://console.mistral.ai
OPENROUTER_API_KEY="API key here" # free models: https://openrouter.ai/keys
CLOUDFLARE_ACCOUNT_ID="API key here" # free: https://dash.cloudflare.com (Workers AI)
CLOUDFLARE_API_TOKEN="API key here"
NVIDIA_API_KEY="API key here" # free for prototyping: https://build.nvidia.com
HETZNER_API_KEY="API key here" # free, experimental: Hetzner Inference API
COHERE_API_KEY="API key here" # trial: https://dashboard.cohere.com (not for commercial use)
SAMBANOVA_API_KEY="API key here" # small free limit: https://cloud.sambanova.ai
CEREBRAS_API_KEY="API key here" # trial credit, needs a card: https://cloud.cerebras.ai
# Paid (optional):
ANTHROPIC_API_KEY="API key here"
OPENAI_API_KEY="API key here"
DEEPSEEK_API_KEY="API key here"
XAI_API_KEY="API key here"
# Order (optional): AI_ORDER=gemini,groq,mistral,openrouter,cloudflare,nvidia,hetzner,cohere,sambanova

# Check that an email domain can receive mail (keep true on the live site)
LEAD_EMAIL_DNS_CHECK=true
